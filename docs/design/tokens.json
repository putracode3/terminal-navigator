  "window": {
    "transparency": { "value": "0", "comment": "FR-15 — written at runtime (0..1) from its own Settings slider, separate from glass.intensity; 0 = fully opaque" },
    "scrimAlpha": { "value": "calc(1 - 0.36 * var(--window-transparency))", "comment": "1.00 → 0.64; floor computed against a WHITE wallpaper (design.md §4.7) — primary text holds 4.70:1 there, muted text does not and is an accepted trade" },
    "light": {
      "scrimAlpha": { "value": "calc(1 - 0.45 * var(--window-transparency))", "comment": "1.00 → 0.55; light-mode floor computed against a BLACK wallpaper (the flipped worst case, design.md §4.7 Light re-derivation) — primary text holds 4.98:1 there, muted text does not and is an accepted trade, same structure as dark mode" }
    }
  },
  "glass": {
    "intensity": { "value": "0", "comment": "FR-14 — the only value written at runtime (0..1) from the Settings slider; 0 = fully opaque" },
    "modalAlpha": { "value": "calc(1 - 0.60 * var(--glass-intensity))", "comment": "1.00 → 0.40; floor re-derived in design.md v2.0 §4.6 against a realistic blurred backdrop, not a full-white screen" },
    "menuAlpha": { "value": "calc(1 - 0.20 * var(--glass-intensity))", "comment": "1.00 → 0.80; tighter floor than the modal — menus float directly over terminal content with no --color-backdrop to damp it" },
    "blur": { "value": "calc(var(--glass-intensity) * 24px)", "comment": "24px dissolves ~8-16px glyphs into the local mean, which is what makes §4.6's averaging model valid; must not be applied at all when intensity is 0 (NFR-9)" },
    "light": {
      "modalAlpha": { "value": "calc(1 - 0.15 * var(--glass-intensity))", "comment": "1.00 → 0.85; a light glass surface gets DARKER as it goes more see-through over dark terminal content — the inverse dynamic from dark mode, hence the much tighter range (design.md §4.6 Light re-derivation)" },
      "menuAlpha": { "value": "calc(1 - 0.20 * var(--glass-intensity))", "comment": "1.00 → 0.80" }
    }
  },
