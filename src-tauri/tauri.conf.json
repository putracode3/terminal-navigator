{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Terminal Navigator",
  "version": "0.2.2",
  "identifier": "com.dennysetiawisnugraha.terminal-navigator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Terminal Navigator",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "maximized": true,
        "visible": false,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
